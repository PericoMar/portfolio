---
import Base from '../layouts/Base.astro';
import Sidebar from './Sidebar.astro';
import Intro from './Intro.astro';
import Experience from './Experience.astro';
import Ai from './Ai.astro';
import Projects from './Projects.astro';
import Skills from './Skills.astro';
import Education from './Education.astro';
import Certifications from './Certifications.astro';
import { getContent, type Locale } from '../data/content';
import { formatMonth } from '../lib/format';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getContent(locale);
const updated = formatMonth(new Date().toISOString().slice(0, 7), locale);
---

<Base locale={locale} title={c.ui.meta.title} description={c.ui.meta.description}>
  <a class="skip-link" href="#main">{c.ui.a11y.skip}</a>
  <div class="arcs" aria-hidden="true"></div>

  <div class="page">
    <Sidebar c={c} locale={locale} />
    <main id="main">
      <Intro c={c} />
      <Experience c={c} locale={locale} />
      <Ai c={c} />
      <Projects c={c} locale={locale} />
      <Skills c={c} />
      <Education c={c} locale={locale} />
      <Certifications c={c} locale={locale} />
      <footer class="foot">
        <p>{c.ui.footer.built} {c.ui.footer.updated}: {updated}.</p>
      </footer>
    </main>
  </div>
</Base>

<script>
  import '../scripts/main.ts';
</script>
