---
import Row from './Row.astro';
import Section from './Section.astro';
import type { Content, Locale } from '../data/content';
import { formatPeriod } from '../lib/format';

interface Props {
  c: Content;
  locale: Locale;
}

const { c, locale } = Astro.props;
---

<Section id="experience" title={c.ui.nav.experience}>
  {c.experience.map((job) => (
    <Row
      title={c.orgs[job.org].name}
      sub={job.role}
      meta={[formatPeriod(job.start, job.end, locale, c.ui.labels.now), ...job.type.split(' · ')]}
      links={job.links}
    >
      <ul>
        {[job.summary, ...job.points].map((p) => <li>{p}</li>)}
      </ul>
      <p class="row-stack">{job.stack.join(' · ')}</p>
    </Row>
  ))}
</Section>
