---
import Flow from './Flow.astro';
import Icon from './Icon.astro';
import type { Content } from '../data/content';

interface Props {
  c: Content;
}

const { c } = Astro.props;
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="eyebrow">01 · {c.ui.nav.work}</p>
      <h2 class="section-title" id="work-title">{c.ui.sections.work}</h2>
    </header>

    <div class="projects">
      {c.featured.map((p, i) => (
        <article class="project spotlight" data-reveal data-spotlight aria-labelledby={`p-${p.id}`}>
          <header class="project-head">
            <p class="kicker mono">
              <span class="index">{String(i + 1).padStart(2, '0')}</span>
              {p.kicker}
            </p>
            <h3 class="project-title" id={`p-${p.id}`}>{p.title}</h3>
            <p class="project-summary">{p.summary}</p>
          </header>

          <div class="project-body">
            <div class="highlights">
              <p class="label mono">{c.ui.project.highlights}</p>
              <ul>
                {p.highlights.map((h, j) => (
                  <li class:list={{ first: j === 0 }}>{h}</li>
                ))}
              </ul>
              {p.outcome && (
                <p class="outcome">
                  <span class="mono">{c.ui.project.outcome}</span>
                  {p.outcome}
                </p>
              )}
            </div>
            <Flow flow={p.flow} label={c.ui.project.architecture} />
          </div>

          <footer class="project-foot">
            <ul class="chips" aria-label="Stack">
              {p.stack.map((s) => <li class="chip">{s}</li>)}
            </ul>
            {p.link && (
              <a class="visit link" href={p.link.href} target="_blank" rel="noopener">
                {c.ui.project.visit} {p.link.label}
                <Icon name="arrow-up-right" />
              </a>
            )}
          </footer>
        </article>
      ))}
    </div>

    <h3 class="also-title mono" data-reveal>{c.ui.sections.also}</h3>
    <ul class="also">
      {c.alsoShipped.map((a, i) => (
        <li class="also-item spotlight" data-reveal data-spotlight style={`--reveal-delay:${i * 0.06}s`}>
          <h4>{a.title}</h4>
          <p>{a.body}</p>
          <ul class="chips">
            {a.tags.map((t) => <li class="chip">{t}</li>)}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .projects {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .project {
    display: grid;
    gap: 1.6rem;
    padding: clamp(1.25rem, 3.5vw, 2.25rem);
  }

  .project-head {
    display: grid;
    gap: 0.75rem;
    max-width: 48rem;
  }

  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    color: var(--faint);
  }

  .index {
    color: var(--accent);
  }

  .project-title {
    font-size: clamp(1.45rem, 3.2vw, 2.1rem);
  }

  .project-summary {
    color: var(--muted);
    font-size: 1.04rem;
  }

  .project-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(1.25rem, 3vw, 2.25rem);
    align-items: start;
  }

  .label {
    margin-bottom: 0.7rem;
    color: var(--faint);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.68rem;
  }

  .highlights ul {
    display: grid;
    gap: 0.7rem;
  }

  .highlights li {
    position: relative;
    padding-left: 1.2rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.45rem;
    height: 1px;
    background: var(--faint);
  }

  .highlights li.first {
    color: var(--text);
  }

  .highlights li.first::before {
    background: var(--accent);
    width: 0.55rem;
    height: 2px;
  }

  .outcome {
    display: grid;
    gap: 0.25rem;
    margin-top: 1.1rem;
    padding: 0.8rem 0.9rem;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    font-size: 0.93rem;
    font-weight: 500;
  }

  .outcome .mono {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.66rem;
  }

  .project-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .visit {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.92rem;
    font-weight: 500;
  }

  .visit :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
  }

  .also-title {
    margin: clamp(3rem, 6vw, 4.5rem) 0 1.1rem;
    color: var(--faint);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.75rem;
  }

  .also {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .also-item {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.25rem 1.35rem;
  }

  .also-item h4 {
    font-size: 1.08rem;
    letter-spacing: -0.015em;
  }

  .also-item p {
    color: var(--muted);
    font-size: 0.93rem;
  }

  .also-item .chips {
    margin-top: 0.3rem;
  }

  @media (max-width: 900px) {
    .project-body {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .also {
      grid-template-columns: 1fr;
    }
  }
</style>
