---
import type { Link } from '../data/content';
import { url } from '../lib/paths';

interface Props {
  title: string;
  sub?: string;
  meta?: string | string[];
  links?: Link[];
}

const { title, sub, meta, links = [] } = Astro.props;
// Keep "Oct 2025" together so ranges only wrap at the dash.
const metaLines = [meta ?? []].flat().filter(Boolean).map((m) => m.replace(/ (?=\d{4})/g, '\u00a0'));
const external = (href: string) => /^https?:/.test(href);
---

<div class="row">
  <div class="row-head">
    <h3 class="row-title">{title}</h3>
    {sub && <p class="row-sub">{sub}</p>}
  </div>
  <div class="row-body">
    <slot />
  </div>
  <div class="row-meta">
    {metaLines.map((m) => <p>{m}</p>)}
    {links.length > 0 && (
      <p class="row-links">
        {links.map((link) => (
          <a
            href={external(link.href) ? link.href : url(link.href)}
            class={link.preview ? 'has-preview' : undefined}
            {...(external(link.href) ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {link.label}
            {link.preview && (
              <span class="link-preview" aria-hidden="true">
                <img src={url(link.preview)} alt="" width="240" height="150" loading="lazy" decoding="async" />
              </span>
            )}
          </a>
        ))}
      </p>
    )}
  </div>
</div>
