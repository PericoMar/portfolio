---
import Icon from './Icon.astro';
import type { Content } from '../data/content';
import { keepHyphens, emphasis, url } from '../lib/paths';

interface Props {
  c: Content;
}

const { c } = Astro.props;
const year = new Date().getFullYear();
const updated = new Date().toISOString().slice(0, 10);
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="card" data-reveal>
      <p class="eyebrow">05 · {c.ui.nav.contact}</p>
      <h2 class="title" id="contact-title">
        {emphasis(c.contact.title).map((s) =>
          s.em ? (
            <span class="serif accent">{s.text}</span>
          ) : (
            keepHyphens(s.text).map((w) => (w.nowrap ? <span class="nowrap">{w.text}</span> : w.text))
          ),
        )}
      </h2>
      <p class="body">{c.contact.body}</p>

      <div class="actions">
        <a class="btn btn-primary email" href={`mailto:${c.profile.email}`}>
          <Icon name="mail" />
          <span class="email-text">{c.profile.email}</span>
        </a>
        <button
          class="btn copy no-print"
          type="button"
          data-copy={c.profile.email}
          data-label-done={c.ui.contact.copied}
        >
          <Icon name="copy" class="i-copy" />
          <Icon name="check" class="i-check" />
          <span data-copy-label>{c.ui.contact.copy}</span>
        </button>
      </div>

      <ul class="elsewhere">
        <li>
          <a class="link" href={c.profile.linkedin} target="_blank" rel="noopener">
            <Icon name="linkedin" /> LinkedIn
          </a>
        </li>
        <li>
          <a class="link" href={c.profile.github} target="_blank" rel="noopener">
            <Icon name="github" /> GitHub
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="container footer-inner mono">
    <p>© {year} {c.profile.name}</p>
    <p class="footer-links">
      <span>{c.ui.footer.built}</span>
      <a class="link" href={url('llms.txt')}>/llms.txt</a>
      <a class="link" href={url('resume.json')}>/resume.json</a>
    </p>
    <p class="updated">{c.ui.footer.updated} {updated}</p>
  </div>
</footer>

<style>
  .contact {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .card {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding: clamp(1.75rem, 6vw, 4.5rem);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) * 1.6);
    background:
      radial-gradient(60rem 30rem at 100% 0%, var(--accent-soft), transparent 60%),
      var(--bg-elev);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .card::after {
    content: '';
    position: absolute;
    right: -6rem;
    bottom: -6rem;
    width: 22rem;
    height: 22rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    box-shadow:
      0 0 0 3rem var(--bg-elev),
      0 0 0 calc(3rem + 1px) var(--line),
      0 0 0 6rem var(--bg-elev),
      0 0 0 calc(6rem + 1px) var(--line);
    opacity: 0.7;
    pointer-events: none;
  }

  .card > * {
    position: relative;
    z-index: 1;
  }

  .title {
    max-width: 14ch;
    font-size: clamp(2.2rem, 6.4vw, 4.4rem);
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .accent {
    color: var(--accent);
  }

  .body {
    max-width: 36rem;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
    max-width: 100%;
  }

  .email {
    max-width: 100%;
    font-size: clamp(0.8rem, 3.7vw, 0.94rem);
  }

  .email-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .copy :global(.i-check) {
    display: none;
    color: var(--ok);
  }

  .copy.is-done :global(.i-copy) {
    display: none;
  }

  .copy.is-done :global(.i-check) {
    display: block;
  }

  .elsewhere {
    display: flex;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }

  .elsewhere a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .elsewhere :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .site-footer {
    padding-block: 2rem 2.5rem;
    border-top: 1px solid var(--line);
    color: var(--faint);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
  }

  .footer-links .link {
    color: var(--muted);
  }

  @media (max-width: 480px) {
    .actions,
    .actions .btn {
      width: 100%;
    }
  }
</style>
