---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import photo from '../assets/pedro.png';
import type { Content } from '../data/content';
import { keepHyphens, emphasis } from '../lib/paths';

interface Props {
  c: Content;
}

const { c } = Astro.props;
---

<section class="hero" id="top">
  <div class="bg-decor" aria-hidden="true">
    <div class="grid"></div>
    <div class="glow"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-meta" data-reveal>
      <Image src={photo} alt="" width={112} height={112} class="avatar" loading="eager" />
      <div class="who">
        <p class="who-name">{c.profile.name}</p>
        <p class="who-role mono">{c.profile.role} · {c.profile.location}</p>
      </div>
    </div>

    {c.profile.availability.show && (
      <p class="status" data-reveal style="--reveal-delay: .05s">
        <span class="status-dot" aria-hidden="true"></span>
        {c.profile.availability.label}
      </p>
    )}

    <h1 class="hero-title" data-reveal style="--reveal-delay: .1s">
      {emphasis(c.hero.title).map((s) =>
          s.em ? (
            <span class="serif accent">{s.text}</span>
          ) : (
            keepHyphens(s.text).map((w) => (w.nowrap ? <span class="nowrap">{w.text}</span> : w.text))
          ),
        )}
    </h1>

    <div class="stream" data-reveal style="--reveal-delay: .2s">
      <div class="stream-head mono" aria-hidden="true">
        <span class="prompt"><span class="caret-sign">$</span> pedro --summary</span>
        <span class="stream-status" data-stream-status data-label-streaming={c.ui.hero.streaming} data-label-done={c.ui.hero.done}>
          <span class="pulse"></span><span data-stream-text>{c.ui.hero.done}</span>
        </span>
      </div>
      <p class="hero-lead" data-stream>{c.hero.lead}</p>
    </div>

    <div class="hero-ctas" data-reveal style="--reveal-delay: .3s">
      <a class="btn btn-primary" href="#work">
        {c.ui.hero.ctaWork}
        <Icon name="arrow-right" />
      </a>
      <a class="btn" href={`mailto:${c.profile.email}`}>
        <Icon name="mail" />
        {c.ui.hero.ctaEmail}
      </a>
      <div class="socials">
        <a class="icon-btn" href={c.profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
          <Icon name="linkedin" />
        </a>
        <a class="icon-btn" href={c.profile.github} target="_blank" rel="noopener" aria-label="GitHub">
          <Icon name="github" />
        </a>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="tldr" data-reveal style="--reveal-delay: .4s">
      <p class="tldr-label mono"><Icon name="sparkle" class="tldr-icon" />{c.ui.hero.tldr}</p>
      <dl class="facts">
        {c.hero.facts.map((f) => (
          <div class="fact">
            <dt class="mono">{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(3rem, 9vw, 7rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
    isolation: isolate;
  }

  .bg-decor {
    position: absolute;
    inset: calc(var(--nav-h) * -1) 0 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--line-strong) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 30%, transparent 75%);
  }

  .glow {
    position: absolute;
    top: -12rem;
    right: -8rem;
    width: 38rem;
    height: 38rem;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-glow), transparent 65%);
    filter: blur(20px);
    animation: drift 18s ease-in-out infinite alternate;
  }

  @keyframes drift {
    to {
      transform: translate(-6rem, 4rem) scale(1.1);
    }
  }

  .hero-inner {
    display: grid;
    gap: 1.6rem;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .avatar {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 999px;
    object-fit: cover;
    box-shadow: 0 0 0 3px var(--bg), 0 0 0 4px var(--line-strong);
  }

  .who-name {
    font-weight: 560;
    letter-spacing: -0.01em;
  }

  .who-role {
    color: var(--muted);
  }

  .status {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.8rem 0.35rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-elev);
    color: var(--muted);
    font-size: 0.85rem;
  }

  .status-dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--ok);
  }

  .status-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping {
    75%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  .hero-title {
    max-width: 16ch;
    font-size: clamp(2.6rem, 7.4vw, 5.4rem);
    font-weight: 540;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .hero-title .serif {
    font-size: 1.08em;
    letter-spacing: -0.02em;
  }

  .accent {
    color: var(--accent);
  }

  .stream {
    max-width: var(--prose);
    border-left: 1px solid var(--line-strong);
    padding-left: 1.1rem;
  }

  .stream-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.55rem;
    color: var(--faint);
  }

  .caret-sign {
    color: var(--accent);
  }

  .stream-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .pulse {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--ok);
  }

  .stream-status.is-streaming .pulse {
    background: var(--accent);
    animation: blink 0.9s ease-in-out infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0.2;
    }
  }

  .hero-lead {
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    line-height: 1.65;
  }

  .hero-lead :global(.tok) {
    transition: opacity 0.35s ease, filter 0.35s ease;
  }

  .hero-lead :global(.tok.is-pending) {
    opacity: 0;
    filter: blur(4px);
  }

  .hero-lead :global(.cursor) {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.15em;
    vertical-align: -0.15em;
    background: var(--accent);
    border-radius: 2px;
    animation: blink 1s steps(2, start) infinite;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }

  .socials {
    display: flex;
    gap: 0.5rem;
    margin-left: 0.25rem;
  }

  .tldr {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    padding: clamp(1.1rem, 3vw, 1.6rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg-elev) 82%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow);
  }

  .tldr-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.7rem;
  }

  .tldr :global(.tldr-icon) {
    width: 0.9rem;
    height: 0.9rem;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem 1.5rem;
    margin: 0;
  }

  .fact {
    display: grid;
    gap: 0.2rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
  }

  .fact dt {
    color: var(--faint);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .fact dd {
    margin: 0;
    font-weight: 500;
    font-size: 0.97rem;
  }

  @media (max-width: 760px) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 440px) {
    .facts {
      grid-template-columns: 1fr;
    }

    .hero-ctas .btn {
      flex: 1 1 auto;
    }

    .socials {
      margin-left: 0;
    }
  }
</style>
