---
import { Image } from 'astro:assets';
import photo from '../assets/pedro.png';
import type { Content } from '../data/content';

interface Props {
  c: Content;
}

const { c } = Astro.props;
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="container about">
    <div class="portrait" data-reveal>
      <Image src={photo} alt={c.profile.name} width={480} height={480} class="photo" />
      <p class="caption mono">{c.profile.location}</p>
    </div>

    <header class="section-head head" data-reveal>
      <p class="eyebrow">04 · {c.ui.nav.about}</p>
      <h2 class="section-title" id="about-title">{c.ui.sections.about}</h2>
    </header>

    <div class="text">
      <div class="prose">
        {c.about.paragraphs.map((p, i) => (
          <p data-reveal style={`--reveal-delay:${i * 0.06}s`}>{p}</p>
        ))}
      </div>
      <ul class="langs" data-reveal>
        {c.profile.languages.map((lang) => (
          <li>
            <span>{lang.name}</span>
            <span class="mono">{lang.level}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    grid-template-areas:
      'portrait head'
      'portrait text';
    grid-template-rows: auto 1fr;
    column-gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .head {
    grid-area: head;
  }

  .text {
    grid-area: text;
  }

  .portrait {
    grid-area: portrait;
    position: sticky;
    top: calc(var(--nav-h) + 2rem);
    display: grid;
    gap: 0.7rem;
  }

  .photo {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: 0 30px 60px -30px var(--accent-glow);
  }

  .caption {
    color: var(--faint);
  }

  .prose {
    display: grid;
    gap: 1.1rem;
    max-width: var(--prose);
  }

  .prose p {
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .prose p:first-child {
    color: var(--text);
    font-size: clamp(1.2rem, 2.4vw, 1.4rem);
    line-height: 1.5;
    letter-spacing: -0.01em;
  }

  .langs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .langs li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-elev);
    font-weight: 500;
    font-size: 0.93rem;
  }

  .langs .mono {
    color: var(--faint);
    font-weight: 400;
  }

  @media (max-width: 760px) {
    .about {
      grid-template-columns: 1fr;
      grid-template-areas:
        'head'
        'portrait'
        'text';
      row-gap: 0;
    }

    .portrait {
      position: static;
      max-width: 12rem;
      margin-bottom: 2rem;
    }
  }
</style>
